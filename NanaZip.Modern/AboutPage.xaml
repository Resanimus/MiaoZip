<Page
  x:Class="NanaZip.Modern.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaZip.Modern"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="True"
  FontFamily="Microsoft YaHei UI" FontSize="13"
  Foreground="{ThemeResource MiaoTextBrush}"
  mc:Ignorable="d">
  <Page.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="ms-appx:///NanaZip.Modern/DialogTheme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Page.Resources>
  <Grid Background="{ThemeResource MiaoChromeSolidBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel Padding="24,20,24,24" Spacing="8">
      <TextBlock
        x:Name="GridTitleTextBlock"
        Margin="0,0,0,12"
        FontSize="20"
        FontWeight="SemiBold"
        Text="MiaoZip" />
      <TextBlock>
        <Run x:Name="Version" />
        <LineBreak />
        <Run Text="MiaoZip v1.0 · Based on NanaZip and 7-Zip" />
        <LineBreak />
        <Run Text="© M2-Team and Contributors. All rights reserved." />
        <LineBreak />
        <LineBreak />
        <Run x:Name="Content" />
      </TextBlock>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="1" Padding="24,16" BorderBrush="{ThemeResource MiaoLineBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        Grid.Column="0"
        HorizontalAlignment="Stretch"
        Click="NanaZipWebsiteButtonClick"
        Content="NanaZip (upstream)" />
      <Button
        Grid.Column="2"
        HorizontalAlignment="Stretch"
        Click="GitHubButtonClick"
        Content="GitHub" />
      <Button
        x:Uid="/NanaZip.Modern/Common/CancelButton"
        Grid.Column="4"
        HorizontalAlignment="Stretch"
        Click="CancelButtonClick"
        Content="[Cancel]" />
    </Grid>
  </Grid>
</Page>
