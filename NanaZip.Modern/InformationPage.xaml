<Page
  x:Class="NanaZip.Modern.InformationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaZip.Modern"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  FontFamily="Microsoft YaHei UI" FontSize="13"
  Foreground="{ThemeResource MiaoTextBrush}"
  mc:Ignorable="d">

  <Page.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="ms-appx:///NanaZip.Modern/DialogTheme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Page.Resources>
  <Grid Background="{ThemeResource MiaoChromeSolidBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      x:Name="TitleTextBlock"
      Margin="24,20,24,12"
      d:Text="[Information]"
      FontSize="20"
      Style="{StaticResource MiaoDialogTitle}" />
    <TextBox
      x:Name="InformationTextBox"
      Grid.Row="1"
      Margin="24,4,24,24"
      AcceptsReturn="True"
      CopyingToClipboard="InformationTextBoxCopyingToClipboardHandler"
      IsReadOnly="True"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
      ScrollViewer.VerticalScrollBarVisibility="Auto">
      <TextBox.SelectionFlyout>
        <TextCommandBarFlyout Placement="BottomEdgeAlignedLeft" />
      </TextBox.SelectionFlyout>
    </TextBox>
    <Grid
      Grid.Row="2"
      Background="{ThemeResource MiaoChromeSolidBrush}"
      BorderBrush="{ThemeResource MiaoLineBrush}"
      BorderThickness="0,1,0,0">
      <StackPanel
        Grid.Column="1"
        Padding="0,0,20,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <Button
          x:Uid="/NanaZip.Modern/Common/CloseButton"
          Width="120"
          Margin="4,16,4,16"
          d:Content="[Close]"
          Click="CloseButtonClickedHandler" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
