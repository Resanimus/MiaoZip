<Page
  x:Class="NanaZip.Modern.CopyLocationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  FontFamily="Microsoft YaHei UI" FontSize="13"
  Foreground="{ThemeResource MiaoTextBrush}" mc:Ignorable="d">
  <Page.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="ms-appx:///NanaZip.Modern/DialogTheme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Page.Resources>
  <Grid Background="{ThemeResource MiaoChromeSolidBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="TitleTextBlock" Style="{StaticResource MiaoDialogTitle}" d:Text="解压" />
        <TextBlock x:Name="SubtitleTextBlock" Margin="0,4,0,-8" Style="{StaticResource MiaoDialogLabel}" d:Text="目标文件夹" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
          <TextBox x:Name="PathTextBox" AutomationProperties.Name="目标文件夹" />
          <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="BrowseButtonClick" Content="浏览…" />
        </Grid>
        <Border Background="{ThemeResource MiaoSurfaceBrush}" BorderBrush="{ThemeResource MiaoLineBrush}"
          BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8">
            <CheckBox x:Name="OrganizeOuterFolderCheck" Content="自动整理外层文件夹"
              ToolTipService.ToolTip="只有一个顶层项目时保留原结构；多个顶层项目时按压缩包名创建文件夹。" />
            <CheckBox x:Name="ExitAfterExtractionCheck" Content="完成后自动关闭 MiaoZip"
              ToolTipService.ToolTip="只在解压成功且没有错误时关闭当前窗口；取消和失败不会退出。" />
            <TextBlock x:Name="AdditionalInformationTextBlock" Margin="0,4,0,0"
              TextWrapping="Wrap" Style="{StaticResource MiaoDialogLabel}" d:Text="文件：1" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" Padding="24,16" BorderBrush="{ThemeResource MiaoLineBrush}" BorderThickness="0,1,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="ExtractAllButton" x:Uid="/NanaZip.Modern/CopyLocationPage/ExtractAllButton"
        Click="ExtractAllButtonClick" Content="[Extract all...]" />
      <Button Grid.Column="2" Margin="0,0,12,0" x:Uid="/NanaZip.Modern/Common/CancelButton"
        Click="CancelButtonClick" Content="[Cancel]" />
      <Button Grid.Column="3" x:Name="PauseButton" x:Uid="/NanaZip.Modern/Common/OKButton"
        Style="{StaticResource MiaoDialogPrimaryButton}" Click="OkButtonClick" Content="[OK]" />
    </Grid>
  </Grid>
</Page>
