<Page
  x:Class="NanaZip.Modern.MainWindowToolBarPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:NanaZip.Modern"
  FontFamily="Microsoft YaHei UI" FontSize="13"
  IsTextScaleFactorEnabled="True">
  <Page.Resources>
    <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
    <x:Double x:Key="AppBarThemeMinHeight">40</x:Double>
    <!-- Keep a fixed-height row; the system AppBar's closed-state clip assumes taller buttons. -->
    <Style x:Key="MiaoCommandBar" TargetType="CommandBar">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="ClosedDisplayMode" Value="Compact" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CommandBar">
        <Grid x:Name="LayoutRoot" Height="40">
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled" /></VisualStateGroup>
            <VisualStateGroup x:Name="DisplayModeStates">
              <VisualState x:Name="CompactClosed" /><VisualState x:Name="CompactOpenUp" /><VisualState x:Name="CompactOpenDown" />
              <VisualState x:Name="MinimalClosed" /><VisualState x:Name="MinimalOpenUp" /><VisualState x:Name="MinimalOpenDown" />
              <VisualState x:Name="HiddenClosed" /><VisualState x:Name="HiddenOpenUp" /><VisualState x:Name="HiddenOpenDown" />
            </VisualStateGroup>
            <VisualStateGroup x:Name="AvailableCommandsStates"><VisualState x:Name="BothCommands" /><VisualState x:Name="PrimaryCommandsOnly" /><VisualState x:Name="SecondaryCommandsOnly" /></VisualStateGroup>
            <VisualStateGroup x:Name="DynamicOverflowStates"><VisualState x:Name="DynamicOverflowEnabled" /><VisualState x:Name="DynamicOverflowDisabled" /></VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Grid x:Name="ContentRoot" Height="40" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="ContentControlColumnDefinition" Width="Auto" /><ColumnDefinition x:Name="PrimaryItemsControlColumnDefinition" Width="*" /></Grid.ColumnDefinitions>
              <ContentControl x:Name="ContentControl" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsTabStop="False" />
              <ItemsControl x:Name="PrimaryItemsControl" Grid.Column="1" Height="40" IsTabStop="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </Grid>
            <Button x:Name="OverflowMenuButton" Click="OverflowMenuClick" AutomationProperties.Name="更多操作" ToolTipService.ToolTip="更多操作" Grid.Column="1" Width="36" Height="40" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
              Foreground="{ThemeResource MiaoTextBrush}" Control.IsTemplateKeyTipTarget="True" IsAccessKeyScope="True"
              Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CommandBarTemplateSettings.EffectiveOverflowButtonVisibility}">
              <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
            </Button>
            <Popup x:Name="OverflowPopup" VerticalOffset="44" IsLightDismissEnabled="True">
              <Grid x:Name="OverflowContentRoot" Background="{ThemeResource MiaoFieldBrush}" BorderBrush="{ThemeResource MiaoLineBrush}" BorderThickness="1" CornerRadius="8"
                MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CommandBarTemplateSettings.OverflowContentMinWidth}"
                MaxWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CommandBarTemplateSettings.OverflowContentMaxWidth}"
                MaxHeight="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CommandBarTemplateSettings.OverflowContentMaxHeight}">
                <Grid.RenderTransform><TranslateTransform X="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CommandBarTemplateSettings.OverflowContentHorizontalOffset}" /></Grid.RenderTransform>
                <!-- The SDK overflow host clears AppBarButton's fixed compact width. -->
                <CommandBarOverflowPresenter x:Name="SecondaryItemsControl" Style="{TemplateBinding CommandBarOverflowPresenterStyle}" IsTabStop="False">
                  <CommandBarOverflowPresenter.ItemContainerStyle>
                    <Style TargetType="FrameworkElement">
                      <Setter Property="HorizontalAlignment" Value="Stretch" />
                      <Setter Property="Width" Value="NaN" />
                    </Style>
                  </CommandBarOverflowPresenter.ItemContainerStyle>
                </CommandBarOverflowPresenter>
              </Grid>
            </Popup>
          </Grid>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassCommand" TargetType="AppBarButton">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Height" Value="40" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Foreground" Value="{ThemeResource MiaoTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="AppBarButton">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ApplicationViewStates">
                  <VisualState x:Name="FullSize" />
                  <VisualState x:Name="Compact" />
                  <VisualState x:Name="LabelOnRight" />
                  <VisualState x:Name="LabelCollapsed" />
                  <VisualState x:Name="Overflow"><VisualState.Setters><Setter Target="CommandContent.HorizontalAlignment" Value="Left" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="OverflowWithToggleButtons"><VisualState.Setters><Setter Target="CommandContent.HorizontalAlignment" Value="Left" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="OverflowWithMenuIcons"><VisualState.Setters><Setter Target="CommandContent.HorizontalAlignment" Value="Left" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="OverflowWithToggleButtonsAndMenuIcons"><VisualState.Setters><Setter Target="CommandContent.HorizontalAlignment" Value="Left" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource MiaoHoverBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource MiaoPressedBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <StackPanel x:Name="CommandContent" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <ContentPresenter Content="{TemplateBinding Icon}" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GlassPrimary" TargetType="AppBarButton" BasedOn="{StaticResource GlassCommand}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="AppBarButton">
        <Border x:Name="Chrome" Background="{ThemeResource MiaoAccentFillBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal" />
            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.88" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.72" /></VisualState.Setters></VisualState>
            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
          </VisualStateGroup></VisualStateManager.VisualStateGroups>
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentPresenter Content="{TemplateBinding Icon}" Width="22" Height="22" VerticalAlignment="Center" Foreground="{ThemeResource MiaoAccentTextBrush}" />
            <TextBlock Text="{TemplateBinding Label}" Foreground="{ThemeResource MiaoAccentTextBrush}" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GlassEdit" TargetType="AppBarToggleButton">
      <Setter Property="Width" Value="112" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="AppBarToggleButton">
            <Border x:Name="Chrome" Background="{ThemeResource MiaoFieldBrush}" BorderBrush="{ThemeResource MiaoLineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource MiaoHoverBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.8" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Checked"><VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource MiaoAccentFillBrush}" />
                    <Setter Target="Chrome.BorderBrush" Value="{ThemeResource MiaoAccentBrush}" />
                    <Setter Target="EditorIcon.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />
                    <Setter Target="EditorLabel.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />


                  </VisualState.Setters></VisualState>
                  <VisualState x:Name="CheckedPointerOver"><VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource MiaoAccentFillBrush}" />
                    <Setter Target="Chrome.BorderBrush" Value="{ThemeResource MiaoAccentBrush}" />
                    <Setter Target="EditorIcon.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />
                    <Setter Target="EditorLabel.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />


                  </VisualState.Setters></VisualState>
                  <VisualState x:Name="CheckedPressed"><VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource MiaoAccentFillBrush}" />
                    <Setter Target="Chrome.BorderBrush" Value="{ThemeResource MiaoAccentBrush}" />
                    <Setter Target="EditorIcon.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />
                    <Setter Target="EditorLabel.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />


                  </VisualState.Setters></VisualState>
                  <VisualState x:Name="CheckedDisabled"><VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource MiaoAccentFillBrush}" />
                    <Setter Target="Chrome.BorderBrush" Value="{ThemeResource MiaoAccentBrush}" />
                    <Setter Target="EditorIcon.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />
                    <Setter Target="EditorLabel.Foreground" Value="{ThemeResource MiaoAccentTextBrush}" />


                  </VisualState.Setters></VisualState>
                </VisualStateGroup>

              </VisualStateManager.VisualStateGroups>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ContentPresenter x:Name="EditorIcon" Content="{TemplateBinding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock x:Name="EditorLabel" Text="{TemplateBinding Label}" Foreground="{ThemeResource MiaoTextBrush}" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" />

              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>
  <Grid Background="{ThemeResource MiaoChromeBrush}" Padding="12,12" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <CommandBar x:Name="MainCommands" Style="{StaticResource MiaoCommandBar}" Grid.Column="0" Background="Transparent" Height="40" MinHeight="40" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" IsOpen="False">
      <CommandBar.PrimaryCommands>
        <AppBarButton x:Name="ExtractButton" Style="{StaticResource GlassPrimary}" Background="{ThemeResource MiaoAccentFillBrush}" Foreground="{ThemeResource MiaoAccentTextBrush}" Click="ExtractButtonClick"><AppBarButton.Icon><PathIcon Data="M9,2H11V10.17L14.09,7.09L15.5,8.5L10,14L4.5,8.5L5.91,7.09L9,10.17Z M3,13H5V17H15V13H17V18A1,1 0 0 1 16,19H4A1,1 0 0 1 3,18Z" /></AppBarButton.Icon></AppBarButton>
        <AppBarButton x:Name="CreateButton" Style="{StaticResource GlassCommand}" Label="创建" AutomationProperties.Name="创建压缩包" ToolTipService.ToolTip="选择文件，创建新的压缩包" Click="CreateButtonClick"><AppBarButton.Icon><PathIcon Data="M4,2H12L17,7V11H15V8H11V4H6V17H10V19H4Z M15,12H17V15H20V17H17V20H15V17H12V15H15Z" /></AppBarButton.Icon></AppBarButton>
        <AppBarButton x:Name="AddButton" Style="{StaticResource GlassCommand}" Click="AddButtonClick" Icon="Add" />
        <AppBarButton x:Name="TestButton" Style="{StaticResource GlassCommand}" Click="TestButtonClick" Icon="Accept" />
        <AppBarSeparator />
        <AppBarButton x:Name="RecoveryButton" Style="{StaticResource GlassCommand}" Icon="Folder" Label="恢复副本" Click="RecoveryButtonClick" />
        <AppBarButton x:Name="MenuButton" Style="{StaticResource GlassCommand}" Click="MoreButtonClick" Icon="List" />
      </CommandBar.PrimaryCommands>
      <CommandBar.SecondaryCommands>
        <AppBarButton x:Name="CopyButton" Click="CopyButtonClick" Icon="Copy" />
        <AppBarButton x:Name="MoveButton" Click="MoveButtonClick" Icon="MoveToFolder" />
        <AppBarButton x:Name="DeleteButton" Click="DeleteButtonClick" Icon="Delete" />
        <AppBarSeparator />
        <AppBarButton x:Name="InfoButton" Click="InfoButtonClick"><AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon></AppBarButton>
        <AppBarButton x:Name="OptionsButton" Click="OptionsButtonClick" Icon="Setting" />
        <AppBarButton x:Name="BenchmarkButton" Click="BenchmarkButtonClick" Icon="Play" />
        <AppBarButton x:Name="AboutButton" Click="AboutButtonClick" Icon="Help" />
      </CommandBar.SecondaryCommands>
    </CommandBar>
    <AppBarToggleButton x:Name="EditModeButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource GlassEdit}" Foreground="{ThemeResource MiaoTextBrush}" Icon="Edit" Label="包内编辑" IsChecked="False" Click="EditModeButtonClick" />
    <Grid x:Name="SearchHost" Grid.Column="2" Width="200" VerticalAlignment="Center">
      <TextBox x:Name="FilterTextBox" MaxLength="512" Height="36" FontSize="13" Foreground="{ThemeResource MiaoTextBrush}" Background="{ThemeResource MiaoFieldBrush}" BorderBrush="{ThemeResource MiaoLineBrush}" Padding="34,6,8,6" CornerRadius="8" PlaceholderText="" KeyDown="FilterTextBoxKeyDown" />
      <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource MiaoMutedBrush}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
    </Grid>
    <Button x:Name="ThemeButton" Grid.Column="3" Width="36" Height="36" Padding="0" VerticalAlignment="Center" Background="{ThemeResource MiaoFieldBrush}" BorderBrush="{ThemeResource MiaoLineBrush}" CornerRadius="8" AutomationProperties.Name="外观与毛玻璃主题" ToolTipService.ToolTip="外观与毛玻璃主题">
      <FontIcon Glyph="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource MiaoTextBrush}" />
      <Button.Flyout><MenuFlyout Placement="Bottom">
        <ToggleMenuFlyoutItem x:Name="SystemThemeItem" Text="跟随系统" Tag="0" Click="ThemeChoiceClick" />
        <ToggleMenuFlyoutItem x:Name="LightThemeItem" Text="浅色" Tag="1" Click="ThemeChoiceClick" />
        <ToggleMenuFlyoutItem x:Name="DarkThemeItem" Text="深色" Tag="2" Click="ThemeChoiceClick" />
        <MenuFlyoutSeparator />
        <ToggleMenuFlyoutItem x:Name="TransparencyItem" Text="毛玻璃效果" Click="TransparencyClick" />
      </MenuFlyout></Button.Flyout>
    </Button>
  </Grid>
</Page>
