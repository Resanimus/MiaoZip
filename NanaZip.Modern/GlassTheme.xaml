<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="MiaoChromeBrush" Color="#C01A1F27" />
      <SolidColorBrush x:Key="MiaoChromeSolidBrush" Color="#FF161A21" />
      <SolidColorBrush x:Key="MiaoAddressHostBrush" Color="Transparent" />
      <SolidColorBrush x:Key="MiaoSurfaceBrush" Color="#FF1A1F27" />
      <SolidColorBrush x:Key="MiaoTextBrush" Color="#FFE7EBF2" />
      <SolidColorBrush x:Key="MiaoMutedBrush" Color="#FFA6AFBF" />
      <SolidColorBrush x:Key="MiaoLineBrush" Color="#FF2D3440" />
      <SolidColorBrush x:Key="MiaoHoverBrush" Color="#FF242D3A" />
      <SolidColorBrush x:Key="MiaoPressedBrush" Color="#FF2B3544" />
      <SolidColorBrush x:Key="MiaoSelectedBrush" Color="#FF263D58" />
      <SolidColorBrush x:Key="MiaoAccentBrush" Color="#FF9BB2CC" />
      <SolidColorBrush x:Key="MiaoAccentFillBrush" Color="#FFA5BAD4" />
      <SolidColorBrush x:Key="MiaoAccentTextBrush" Color="#FF10243D" />
      <SolidColorBrush x:Key="MiaoFieldBrush" Color="#A0141921" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="MiaoChromeBrush" Color="#70F3F7FD" />
      <SolidColorBrush x:Key="MiaoChromeSolidBrush" Color="#FFF3F7FD" />
      <SolidColorBrush x:Key="MiaoAddressHostBrush" Color="Transparent" />
      <SolidColorBrush x:Key="MiaoSurfaceBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MiaoTextBrush" Color="#FF202D40" />
      <SolidColorBrush x:Key="MiaoMutedBrush" Color="#FF687A91" />
      <SolidColorBrush x:Key="MiaoLineBrush" Color="#FFDEE6F1" />
      <SolidColorBrush x:Key="MiaoHoverBrush" Color="#FFE0E9F4" />
      <SolidColorBrush x:Key="MiaoPressedBrush" Color="#FFE6EEF9" />
      <SolidColorBrush x:Key="MiaoSelectedBrush" Color="#FFCDDDEE" />
      <SolidColorBrush x:Key="MiaoAccentBrush" Color="#FF476486" />
      <SolidColorBrush x:Key="MiaoAccentFillBrush" Color="#FF5D7897" />
      <SolidColorBrush x:Key="MiaoAccentTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MiaoFieldBrush" Color="#AFFFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="MiaoChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MiaoChromeSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MiaoAddressHostBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MiaoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MiaoTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MiaoMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MiaoLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MiaoHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="MiaoPressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MiaoSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="MiaoAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="MiaoAccentFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="MiaoAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="MiaoFieldBrush" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
</ResourceDictionary>
